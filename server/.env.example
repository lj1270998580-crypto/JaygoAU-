# Jaygo AU 服务端环境变量示例（复制为 .env 后按需修改，.env 切勿提交/打包）
# 本地临时存储方案「不需要任何阿里云 OSS 密匙」——音频存在 ECS 本地磁盘。

# 监听端口（需与 nginx proxy_pass 一致）
PORT=8787

# 对外公开基址（返回给客户端的 putUrl/getUrl 前缀）
PUBLIC_BASE_URL=https://ailabing.cn

# 上传文件落盘目录（后端会自动 mkdir -p）
# 注意：必须放在网站 web root（/www/wwwroot/ailabing.cn）之外，
# 否则 nginx 会直接以静态文件提供，绕过 token 鉴权。
UPLOAD_DIR=/www/jaygo-au-uploads

# 票据有效期（秒）：上传/下载 URL 可使用的时长
TOKEN_TTL=3600

# 文件超期自动清理（秒）：即便未显式删除，超期文件也会被定时任务清掉
FILE_TTL=7200

# 单文件上传体积上限（字节），默认 200MB
MAX_UPLOAD_BYTES=209715200

# 可选：与客户端 electron/main.ts 中 APP_CONFIG.appToken 保持一致，过滤随机扫描（非保密，可留空）
APP_TOKEN=
