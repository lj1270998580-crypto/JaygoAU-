# Jaygo AU 服务端环境变量示例（复制为 .env 后填入真实值，.env 切勿提交/打包）
# 真实 OSS AK/SK 只存在于服务器，绝不进客户端安装包

# 监听端口
PORT=8787

# 阿里云 OSS（转录临时托管用）
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：与客户端 electron/main.ts 中 APP_CONFIG.appToken 保持一致，过滤随机扫描（非保密）
APP_TOKEN=

# 更新文件目录（electron-builder 产物放这里：latest.yml / Jaygo.AU.Setup.*.exe / *.blockmap）
UPDATE_DIR=/www/wwwroot/ailabing.cn/jaygo-au/updates

# 预签名有效期（秒），可按需调整
OSS_PUT_EXPIRES=300
OSS_GET_EXPIRES=3600
