{
  "name": "jaygo-au",
  "version": "0.1.0",
  "description": "Jaygo AU — 火山引擎声音复刻 & 语音合成桌面工具 (Glassmorphism UI)",
  "private": true,
  "author": "Jaygo",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron -k \"vite\" \"cross-env DEV=1 tsc -p tsconfig.electron.json && tsx electron/main.ts\"",
    "build": "vite build --emptyOutDir=false && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder --win --dir && node scripts/apply-icon.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.jaygo.au",
    "productName": "Jaygo AU",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "useZip": true
    },
    "compression": "store"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "zustand": "^4.5.5"
  }
}
