{
  "name": "jaygo-au",
  "version": "0.4.1",
  "description": "Jaygo AU — 全能 AI 自媒体创作工作台 (语音合成 · 声音复刻 · 蝉镜数字人 · 媒体提取 · 智能转录)",
  "private": true,
  "author": "Jaygo",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron -k \"vite\" \"cross-env DEV=1 tsc -p tsconfig.electron.json && tsx electron/main.ts\"",
    "build": "npm run typecheck && vite build --emptyOutDir=false && tsc -p tsconfig.electron.json && node -e \"require('fs').copyFileSync('build/icon.ico', 'dist-electron/icon.ico')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder --win --dir --publish=never",
    "release": "npm run build && electron-builder --win --publish=never",
    "deploy:update": "bash scripts/deploy-update.sh"
  },
  "dependencies": {
    "ali-oss": "^6.21.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.jaygo.au",
    "productName": "Jaygo AU",
    "artifactName": "Jaygo.AU.Setup.${version}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://ailabing.cn/jaygo-au/updates"
      }
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "directories": {
      "output": "D:/jaygoau_build/release-out"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false
    },
    "compression": "normal"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "zustand": "^4.5.5"
  }
}
